@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IOptions<YouTubeSettings> Options

<section class="card">
    <h2>YouTube player demo</h2>
    <p class="hint">
        Manual demo with the official YouTube IFrame Player API, separate from the concurrency test: one
        embedded player, started by the user with the player's own play button. Nothing here is counted in the
        session metrics above, and the concurrency test never contacts YouTube.
    </p>

    @if (string.IsNullOrEmpty(Options.Value.VideoId))
    {
        <p class="hint">No video configured. Set <code>YouTubeSettings:VideoId</code> in appsettings.json to an owned or authorised video.</p>
    }
    else
    {
        <div class="yt-layout">
            <div class="yt-frame"><div id="yt-player"></div></div>
            <dl class="yt-info">
                <dt>Player state</dt><dd>@StateName</dd>
                <dt>Position</dt><dd>@FormatSeconds(position) / @FormatSeconds(duration)</dd>
                <dt>Player ready at</dt><dd>@FormatTime(readyAt)</dd>
                <dt>First played at</dt><dd>@FormatTime(firstPlayedAt)</dd>
                <dt>Last state change</dt><dd>@FormatTime(lastChangeAt)</dd>
                <dt>Ended at</dt><dd>@FormatTime(endedAt)</dd>
                <dt>Error</dt><dd class="error-cell">@(error ?? "-")</dd>
            </dl>
        </div>
    }
</section>

@code {
    private IJSObjectReference? module;
    private DotNetObjectReference<YouTubeDemo>? self;
    private int state = -1;
    private double position;
    private double duration;
    private DateTimeOffset? readyAt;
    private DateTimeOffset? firstPlayedAt;
    private DateTimeOffset? lastChangeAt;
    private DateTimeOffset? endedAt;
    private string? error;

    private string StateName => state switch
    {
        -1 => "Unstarted",
        0 => "Ended",
        1 => "Playing",
        2 => "Paused",
        3 => "Buffering",
        5 => "Video cued",
        _ => $"Unknown ({state})"
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || string.IsNullOrEmpty(Options.Value.VideoId))
        {
            return;
        }

        try
        {
            module = await JS.InvokeAsync<IJSObjectReference>("import", "./youtube-player.js");
            self = DotNetObjectReference.Create(this);
            await module.InvokeVoidAsync("create", "yt-player", Options.Value.VideoId, self);
        }
        catch (JSException ex)
        {
            error = ex.Message;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public Task OnReady(double videoDuration)
    {
        readyAt = DateTimeOffset.Now;
        duration = videoDuration;
        return Refresh();
    }

    [JSInvokable]
    public Task OnStateChange(int newState, double currentTime, double videoDuration)
    {
        state = newState;
        position = currentTime;
        duration = videoDuration;
        lastChangeAt = DateTimeOffset.Now;
        if (newState == 1)
        {
            firstPlayedAt ??= lastChangeAt;
        }
        else if (newState == 0)
        {
            endedAt = lastChangeAt;
        }

        return Refresh();
    }

    [JSInvokable]
    public Task OnProgress(double currentTime, double videoDuration)
    {
        position = currentTime;
        duration = videoDuration;
        return Refresh();
    }

    [JSInvokable]
    public Task OnError(int code)
    {
        error = code switch
        {
            2 => "Invalid video id (code 2).",
            5 => "The HTML5 player reported an error (code 5).",
            100 => "Video not found or private (code 100).",
            101 or 150 => $"The video cannot be played in an embedded player: embedding is not allowed "
                + $"or the video does not exist (code {code}).",
            _ => $"Player error (code {code})."
        };
        lastChangeAt = DateTimeOffset.Now;
        return Refresh();
    }

    private Task Refresh() => InvokeAsync(StateHasChanged);

    private static string FormatTime(DateTimeOffset? value) => value?.ToString("HH:mm:ss") ?? "-";

    private static string FormatSeconds(double seconds) =>
        TimeSpan.FromSeconds(Math.Max(0, seconds)).ToString(@"mm\:ss");

    public async ValueTask DisposeAsync()
    {
        if (module is not null)
        {
            try
            {
                await module.InvokeVoidAsync("dispose");
                await module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // The circuit is already gone, so the browser has released the player.
            }
        }

        self?.Dispose();
    }
}
